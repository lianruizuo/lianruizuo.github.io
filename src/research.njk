---
layout: page.njk
title: Research
intro: "Medical images are measurements, and every measurement comes from a device or scanner. My work is organized around three questions about what a measurement can and cannot tell us. Each comes with a small picture in the spirit of the one on the front page. The papers listed are a selection; the full list is under [Publications](/publications/)."
scripts: ["/assets/js/research.js"]
---
<section class="span rs-map-wrap" aria-label="Where each question sits">
  <div class="row"><div class="m">Where each question sits</div><div class="t">
    {#- steps: label, icon, and which questions (1-based) cover it; icons are simple line drawings made for this page #}
    {%- set steps = [["Patient", "patient", []], ["Device / scanner", "scanner", [1]], ["Measurement", "measurement", [1, 2, 3]], ["Decision", "decision", [3]]] %}
    {%- set spans = [[2, 4], [3, 4], [3, 5]] %}
    <div class="rs-map">
      {%- for s in steps %}
      <{{ "button type=\"button\"" | safe if s[2].length else "span" }} class="rs-step{% if not s[2].length %} rs-step-still{% endif %}" style="grid-column: {{ loop.index }}"{% if s[2].length %} data-arcs="{{ s[2] | join(' ') }}"{% endif %}>
        <span class="rs-icon" aria-hidden="true"><svg viewBox="0 0 32 32">
          {%- if s[1] == "patient" %}<circle cx="16" cy="10.5" r="5"/><path d="M6.5 27c0-5.6 4.3-9.5 9.5-9.5s9.5 3.9 9.5 9.5"/>
          {%- elif s[1] == "scanner" %}<circle cx="13" cy="13.5" r="10.5"/><circle cx="13" cy="13.5" r="4.8"/><path d="M9.5 16h20.5v1.8H9.5M8.5 23.2l-1.6 4.3M17.5 23.2l1.6 4.3M4.5 27.5h17M27 17.8v9.7M24.5 27.5h5"/>
          {%- elif s[1] == "measurement" %}<rect x="3.5" y="4.5" width="17" height="17" rx="1.5"/><path d="M7 15c1.5-4 6-5.5 9.5-3.5M8.5 18.5c2-2.6 5.5-3.2 8-1.8"/><rect x="15.5" y="12.5" width="13" height="15.5" rx="1.5" class="fill"/><path d="M18.5 17h7M18.5 20.5h7M18.5 24h4.5"/>
          {%- else %}<rect x="7" y="3.5" width="18" height="25" rx="1.5"/><path d="M10.5 9h11M10.5 12.5h7"/><path d="M11.5 20.5l3 3 6-7"/>
          {%- endif %}</svg></span>
        {%- if not loop.last %}<span class="rs-arrow" aria-hidden="true"><svg viewBox="0 0 8 10"><path d="M1.5 1.5L6.5 5l-5 3.5"/></svg></span>{% endif %}
        <span class="rs-step-label">{{ s[0] }}</span>
      </{{ "button" if s[2].length else "span" }}>
      {%- endfor %}
      {%- for arc in research.arcs %}
      <a class="rs-bar rs-arc-{{ loop.index }}" href="#{{ arc.id }}" data-arc="{{ loop.index }}" style="grid-column: {{ spans[loop.index0][0] }} / {{ spans[loop.index0][1] }}" aria-label="{{ arc.title }}"><span class="rs-num">{{ loop.index }}</span></a>
      {%- endfor %}
      <ol class="rs-qs">
        {%- for arc in research.arcs %}
        <li><a class="rs-arc rs-arc-{{ loop.index }}" href="#{{ arc.id }}" data-arc="{{ loop.index }}">
          <span class="rs-arc-text"><span class="rs-num">{{ loop.index }}</span><i>{{ arc.title }}</i></span>
          <span class="rs-where"><span>{{ arc.where }}</span></span>
        </a></li>
        {%- endfor %}
      </ol>
    </div>
  </div></div>
</section>
{%- for arc in research.arcs %}
<section class="arc span rs-arc-sec rs-arc-{{ loop.index }}" id="{{ arc.id }}">
  <div class="row"><div class="m"><span class="rs-num">{{ loop.index }}</span></div><div class="t">
    <h2>{{ arc.title }}</h2>
    <figure class="rsf rsf-{{ arc.fig }}">
      <canvas data-fig="{{ arc.fig }}" tabindex="0" role="img" aria-label="{{ arc.caption }}"></canvas>
      <div class="rsf-foot">
        {%- if arc.fig == "scanners" %}
        <button type="button" class="chip" data-act="harmonize" aria-pressed="false">Harmonize</button>
        {%- elif arc.fig == "recover" %}
        <button type="button" class="chip" data-act="recover" aria-pressed="false">Recover</button>
        <button type="button" class="chip" data-act="truth" aria-pressed="false">Show the patient</button>
        {%- elif arc.fig == "value" %}
        <div class="rsf-meter"><div class="rsf-bar" aria-hidden="true"></div><p class="rsf-known" aria-live="polite"></p></div>
        <button type="button" class="chip" data-act="reset">Start over</button>
        {%- endif %}
      </div>
      <figcaption>{{ arc.caption }}</figcaption>
    </figure>
    {{ arc.body | mdBlock | safe }}
  </div></div>
  <div class="row arc-papers"><div class="m">Selected papers</div><div class="t">
    <ul class="pub-list">
      {%- for p in publications.all | byKeys(arc.papers) %}{% include "pub.njk" %}{% endfor %}
    </ul>
  </div></div>
</section>
{%- endfor %}

<section class="span" id="funding">
  <div class="row section-head"><div class="m"></div><div class="t"><h2>Funding</h2></div></div>
  <ul class="row-list">
    {%- for f in research.funding %}
    <li class="row"><div class="m">{{ f.years }}</div><div class="t"><p><i>{{ f.title }}</i><br><span class="muted">{{ f.sponsor }}. {{ f.role }}.</span></p></div></li>
    {%- endfor %}
  </ul>
</section>

---
layout: base.njk
title: Teaching
permalink: /teaching/
description: Answers are cheap now. Knowing which ones to trust is not.
scripts: ["/assets/js/atlas.js"]
---
{%- set map = atlas | atlasLayout(collections.atlas) %}
<header class="teach-head span">
  <h1 class="sr-only">Teaching</h1>
  <p class="teach-line">Answers are cheap now. Knowing which ones to trust is not.</p>
</header>

<div class="wide amap-wrap">{% include "atlas-map.njk" %}</div>

<section class="span" id="courses">
  <div class="row section-head"><div class="m"></div><div class="t"><h2>Courses</h2></div></div>
  <ul class="row-list course-list">
    {%- for c in cv.teaching %}
    <li class="row">
      <div class="m">{{ c.term }}</div>
      <div class="t">
        <h3><a href="/teaching/{{ c.slug }}/">{{ c.course }}</a></h3>
        <p>{{ c.role }}, {{ c.where }}</p>
      </div>
    </li>
    {%- endfor %}
  </ul>
</section>

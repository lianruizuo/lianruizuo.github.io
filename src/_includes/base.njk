<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " — " + site.title) if title and title != site.title else (site.title + " · Medical imaging and machine learning") %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description or summary or site.description }}">
<meta name="author" content="Lianrui Zuo">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or summary or site.description }}">
<meta property="og:type" content="{{ 'article' if layout == 'note.njk' or layout == 'entry.njk' else 'website' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/portrait.jpg">
<meta name="theme-color" content="#f4f5f2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#14171c" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="Lianrui Zuo">
<link rel="preload" href="/assets/fonts/literata-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
{%- if math %}
<link rel="stylesheet" href="/assets/katex/katex.min.css">
<link rel="stylesheet" href="/assets/css/code.css">
{%- endif %}
{%- if site.goatcounter %}
<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{%- endif %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="grid">
  <header class="masthead wide">
    <a class="wordmark" href="/">Lianrui Zuo</a>
    <nav class="nav" aria-label="Main">
      {%- for item in [["Research","/research/"],["Publications","/publications/"],["Teaching","/teaching/"],["Outside Work","/outside/"],["About","/about/"]] %}
      <a href="{{ item[1] }}"{% if page.url.startsWith(item[1]) %} aria-current="page"{% endif %}>{{ item[0] }}</a>
      {%- endfor %}
    </nav>
  </header>
</div>

<main id="main" class="grid {{ mainClass or '' }}">
{{ content | safe }}
</main>

<footer class="grid">
  <div class="colophon span">
    <div class="row">
      <div class="m">© {{ build.date | year }} Lianrui Zuo</div>
      <div class="t">
        <ul class="contact" style="margin:0 0 .6rem">
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          {%- for l in site.links %}<li><a href="{{ l.url }}" rel="me">{{ l.label }}</a></li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</footer>
{%- for s in scripts or [] %}
<script src="{{ s }}" defer></script>
{%- endfor %}
</body>
</html>

{#- The Visitors corner: a world map of where visitors came from; hover a country for its count.
    Drawn at build time from visitorsCorner; hidden when there's nothing yet. -#}
{%- set vz = visitorsCorner %}
{%- if vz %}
<section class="span vz" aria-labelledby="vz-h" data-vz>
  <div class="row">
    <div class="m"><h2 id="vz-h" class="vz-h">Visitors</h2></div>
    <div class="t">
      <figure class="vz-world">
        <svg viewBox="{{ vz.world.box }}" role="img" aria-label="World map; countries with visitors are shaded, darker for more visits.">
          <path class="vz-land" d="{{ vz.world.land }}"/>
          {%- for p in vz.world.lit %}
          <g class="vz-place" data-name="{{ p.name }}" data-n="{{ p.count }}" tabindex="0"><path class="vz-hit" d="{{ p.d }}"/><path class="vz-dot vz-l{{ p.level }}" d="{{ p.d }}"/></g>
          {%- endfor %}
        </svg>
      </figure>
      <div class="vz-tip" role="status" aria-live="polite" hidden></div>
    </div>
  </div>
</section>
{%- endif %}

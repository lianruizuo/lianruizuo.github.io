{#- One row in an Outside Work list. Expects `p` (a story, or a book's index page), `chs` (all chapters) and `dateFormat`.
    A book shows once, dated by its newest chapter, and links only to its own page. -#}
<li class="row">
  <div class="m">{% if dateFormat == "short" %}{{ p | entryDate(chs) | shortDate }}{% else %}{{ p | entryDate(chs) | longDate }}{% endif %}</div>
  <div class="t">
    <h3><a href="{{ p.url }}">{{ p.data.bookTitle if p.data.book else p.data.title }}</a>{% if p.data.draft %}<span class="draft-flag">Draft</span>{% endif %}</h3>
    {%- if p.data.summary %}<p>{{ p.data.summary }}</p>{% endif %}
  </div>
</li>

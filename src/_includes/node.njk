---
layout: base.njk
math: true
mainClass: node-page
---
{%- set map = atlas | atlasLayout(collections.atlas) %}
{%- set me = map.at[node] %}
{%- set cx = map | crossingsFor(node) %}

<header class="node-head row">
  <div class="m"><a href="/teaching/" class="crumb">Atlas</a>{% if talk %}<br><span>Seminar</span>{% elif me %}<br><span class="node-year">{{ me.year }}</span>{% endif %}</div>
  <div class="t">
    <h1>{{ title }}</h1>
    {%- if question %}<p class="node-question">{{ question }}</p>{% endif %}
    {%- if talk %}
    {#- a seminar: who, when and where are public; how to join online is inside the lock #}
    <dl class="talk">
      <div><dt>Speaker</dt><dd><span class="talk-name">{{ talk.speaker }}</span>{% for l in talk.affiliation %}<br>{{ l }}{% endfor %}</dd></div>
      <div><dt>When</dt><dd>{{ talk.date | talkDate }}<br>{{ talk.time }}</dd></div>
      <div><dt>Where</dt><dd>{{ talk.place }}</dd></div>
    </dl>
    {%- endif %}
    {%- if source %}
    <p class="node-source"><span class="label">Primary source</span> {{ source.authors }}, “{{ source.title }},” <i>{{ source.venue }}</i>, {{ source.details }}, {{ source.year }}.{% if source.doi %} <a href="https://doi.org/{{ source.doi }}">doi:{{ source.doi }}</a>{% endif %}</p>
    {%- endif %}
  </div>
</header>

<div class="node-body span">
  <nav class="arc-rail" aria-label="On this page"><ol></ol></nav>
  <article class="prose node-prose">
{%- set priv = node | privateLecture %}
{%- set pd = node | privateData %}
{%- set crossings = pd.crossings or crossings %}
{%- set record = pd.record or record %}
{%- set tail %}
    {%- if not talk or cx.out.length %}
    <h2 id="crossings">Crossings</h2>
    <p>Every boundary found above is a place where another method starts. {% if cx.out.length %}These are the ones the atlas already knows about.{% endif %}</p>
    {%- if cx.out.length %}
    <ul class="crossings">
      {%- for e in cx.out %}
      <li>
        <span class="layer-chip layer-{{ e.layer }}">{{ (atlas | layerOf(e.layer)).name }}</span>
        <span class="cx-when">When {{ e.when | join("; or when ") }}</span>
        <span class="cx-to">{% if e.b.written %}<a href="{{ e.b.url }}">{{ e.b.title }}</a>{% else %}{{ e.b.title }} <span class="soon">planned</span>{% endif %}<span class="cx-how">{{ e.how or ("same information, better criterion" if e.layer == "criterion" else "sees or says more") }}</span></span>
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}
    {%- endif %}
    {%- if cx.into.length %}
    <p class="muted small">{{ "This seminar picks up from a boundary of" if talk else "This method crosses a boundary of" }} {% for e in cx.into %}<a href="{{ e.a.url }}">{{ e.a.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
    {%- endif %}
    {%- if record and record.length %}
    <h2 id="record">Record</h2>
    <p class="muted small">Bugs, tests, failure cases and crossings added to this node, semester by semester. <a href="/teaching/atlas/contribute/">How to add one</a>.</p>
    <ul class="record">
      {%- for r in record %}
      <li><span class="rec-term">{{ r.term }}</span><span class="rec-kind">{{ r.kind }}</span><span class="rec-title">{{ r.title | md | safe }}</span><span class="rec-by">{{ r.by }}</span></li>
      {%- endfor %}
    </ul>
    {%- endif %}
{%- endset %}
{#- a seminar's abstract or outline is public, so it sits outside the lecture markers #}
    {%- if talk.abstract %}
    <h2 id="abstract">Abstract</h2>
    {{ talk.abstract | mdBlock | safe }}
    {%- endif %}
    {%- if talk.outline %}
    <h2 id="outline">What we’ll explore</h2>
    <ol class="talk-outline">
      {%- for o in talk.outline %}<li><span class="talk-topic">{{ o.topic }}</span>{% if o.points %}<span class="talk-points">{{ o.points | join(" · ") }}</span>{% endif %}</li>{% endfor %}
    </ol>
    {%- endif %}
{%- if priv %}
<!--lecture-->
{% renderFile priv, {}, "njk,md" %}
{%- for l in labs or [] %}
<script src="/assets/js/labs/{{ l }}.js?v={{ build.stamp }}"></script>
{%- endfor %}
{{ tail | safe }}
<!--/lecture-->
{%- elif locked %}
    {%- set pvs = previews or ([preview] if preview else []) %}
    {%- for pv in pvs %}
    <figure class="preview" data-preview>
      <div class="lab" data-lab="{{ pv.lab }}"></div>
      {%- if pv.caption %}<figcaption class="preview-cap">{{ pv.caption | md | safe }}</figcaption>{% endif %}
    </figure>
    {%- endfor %}
    {%- if lockedData[node] %}
    <div class="gate" data-gate data-node="{{ node }}">
      {%- set code %}{% for c in atlas.courses %}{% if node in c.route | routeIds %}{{ c.code }}{% endif %}{% endfor %}{% endset %}
      <p class="gate-note">{% if talk %}The Zoom link and the flyer are open to students in {{ code }}. Enter the course password to see them.{% else %}The full lecture is open to students in {{ code }}. Enter the course password to read it.{% endif %}</p>
      <form class="gate-form" autocomplete="off">
        <label class="sr-only" for="gate-pw">Course password</label>
        <input id="gate-pw" type="password" name="pw" placeholder="Course password" required>
        <button type="submit" class="chip chip-strong">Open</button>
      </form>
      <p class="gate-msg" aria-live="polite"></p>
      <script type="application/json" data-payload>{{ lockedData[node] | dump | safe }}</script>
    </div>
    <div class="lecture-body" data-lecture hidden></div>
    {%- else %}
    <p class="muted">{{ "Details for students will be posted here." if talk else "This lecture has not been published yet." }}</p>
    {%- endif %}
{%- else %}
{{ content | safe }}
{{ tail | safe }}
{%- endif %}
  </article>
</div>
{% include "trace.njk" %}

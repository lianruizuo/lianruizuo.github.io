---
layout: base.njk
scripts: ["/assets/js/reader.js"]
---
{#- One chapter of a book in Outside Work. The book page, chapter order and "To be continued" come from the book's folder. -#}
{%- set hub = collections.books | bookHub(book) %}
{%- set chs = collections.chapters | bookChapters(book) %}
{%- set nb = chs | neighbors(page.url) %}
{%- set latest = chs | last %}
<header class="post-head row">
  <div class="m"><a href="/outside/" style="text-decoration:none">Outside Work</a></div>
  <div class="t">
    <h1><a class="book-home" href="{{ hub.url }}">{{ bookTitle }}</a></h1>
    <p class="post-meta"><span>Written {{ page.date | longDate }}</span>{% if draft %}<span class="draft-flag">Draft, not published</span>{% endif %}</p>
  </div>
</header>
<article class="prose" style="display:contents">
<div class="book-cover">
  {%- if hub.data.subtitle %}<p class="book-kicker">{{ hub.data.subtitle }}</p>{% endif %}
  <p class="book-chapter">Chapter {{ chapter | chapterWord }}</p>
  <p class="book-chapter-title">{{ chapterTitle }}</p>
</div>
{{ content | safe }}
<div class="book-end">
  <p class="book-break" aria-hidden="true">* * *</p>
  {%- if latest and page.url == latest.url and not hub.data.finished %}
  <p class="book-continued">To be continued</p>
  {%- endif %}
  {%- if hub.data.credit %}<p class="book-credit">{{ hub.data.credit }}</p>{% endif %}
</div>
</article>
{% set traceInvite = "Say hello. Only I will see it." %}{% set usefulLabel = "I enjoyed this" %}{% set usefulDone = "Glad you did" %}
{% include "trace.njk" %}
<nav class="pager book-pager" aria-label="Chapters">
  {%- if nb.prev %}<a class="prev" href="{{ nb.prev.url }}"><span class="lab">Chapter {{ nb.prev.data.chapter | chapterWord }}</span>{{ nb.prev.data.chapterTitle }}</a>{% endif %}
  <a class="book-all" href="{{ hub.url }}"><span class="lab">All chapters</span>{{ bookTitle }}</a>
  {%- if nb.next %}<a class="next" href="{{ nb.next.url }}"><span class="lab">Chapter {{ nb.next.data.chapter | chapterWord }}</span>{{ nb.next.data.chapterTitle }}</a>{% endif %}
</nav>

---
layout: base.njk
math: true
scripts: ["/assets/js/reader.js"]
---
<header class="post-head row">
  <div class="m"><a href="/outside/" style="text-decoration:none">Outside Work</a></div>
  <div class="t">
    <h1>{{ title }}</h1>
    <p class="post-meta"><span>Written {{ page.date | longDate }}</span>{% if place %}<span>{{ place }}</span>{% endif %}{% if draft %}<span class="draft-flag">Draft, not published</span>{% endif %}</p>
  </div>
</header>
<article class="prose" style="display:contents">
{{ content | safe }}
</article>
{% set traceInvite = "Say hello. Only I will see it." %}{% set usefulLabel = "I enjoyed this" %}{% set usefulDone = "Glad you did" %}
{% include "trace.njk" %}
<nav class="pager" aria-label="Outside Work">
  <a class="next" href="/outside/"><span class="lab">Back to</span>Outside Work</a>
</nav>
